#!/bin/sh
# bubbles — thin wrapper for update/doctor/reload/theme/rollback (PRD §7).
# POSIX sh, no package-manager abstraction: pacman/paru only.

set -eu

CONFIG=bubbles
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/bubbles"   # matches Theme.qml
LEGACY_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/pill"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/bubbles"
GREETER_PALETTE=/etc/xdg/bubbles/GreeterPalette.qml
GREETER_WALLPAPER=/etc/xdg/bubbles/greeter-wallpaper.jpg
SNAP_DIR="/.snapshots/bubbles"
REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"

THEMES="dynamic ariadne gruvbox catppuccin tokyonight nord rosepine everforest"

msg()  { printf 'bubbles: %s\n' "$*"; }
die()  { printf 'bubbles: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

is_btrfs() { [ "$(findmnt -no FSTYPE / 2>/dev/null)" = "btrfs" ]; }

# Talk to the running shell: installed config name first, source tree fallback.
shell_ipc() { # args after 'call <target> <fn>'
    qs -c "$CONFIG" ipc "$@" >/dev/null 2>&1 \
        || qs ipc --path "$HOME/.config/quickshell/$CONFIG/shell" "$@" >/dev/null 2>&1 \
        || qs ipc --path "$REPO_DIR/shell" "$@"
}

# ponytail: plain btrfs snapshots, rsync restore — swap for snapper or
# subvol-default swapping if rsync-restore ever proves too slow/lossy.
snapshot() { # $1 = label
    is_btrfs || { msg "WARNING: root is not btrfs — skipping $1 snapshot (run 'bubbles doctor')"; return 0; }
    mkdir -p "$SNAP_DIR"
    btrfs subvolume snapshot / "$SNAP_DIR/$1-$(date +%Y%m%d-%H%M%S)"
}

usage() {
    cat <<EOF
usage: bubbles <command>

  reload            restart the Quickshell shell (fast iteration loop)
  doctor            check environment: binaries, versions, btrfs support
  theme <name>      switch theme (or re-derive dynamic); syncs greeter palette
  greeter           push palette + lock wallpaper to the sign-in screen (pkexec)
  update [-S]       pull config + reload; -S adds a paru -Syu pass.
                    paired pre/post btrfs snapshots; aborts before any
                    change if the package step fails
  rollback          restore the most recent pre-update snapshot

themes: $THEMES, plus ~/.config/bubbles/themes/<name>.json
EOF
    exit "${1:-0}"
}

sync_greeter_palette() {
    [ -f "$CACHE_DIR/GreeterPalette.qml" ] || return 0
    # Escalation order per PRD/ryoku: user palette already written by the
    # shell; the system copy is best-effort with an honest failure message.
    # Palette + lock wallpaper go in one pkexec call (one polkit prompt).
    # ponytail: 20s polkit window — enough to type a password, won't hang a
    # script when no agent is running.
    _payload="install -Dm644 \"$CACHE_DIR/GreeterPalette.qml\" \"$GREETER_PALETTE\""
    if [ -f "$CACHE_DIR/lock-frame.jpg" ]; then
        _payload="$_payload; install -Dm644 \"$CACHE_DIR/lock-frame.jpg\" \"$GREETER_WALLPAPER\""
    fi
    if timeout 20 pkexec sh -c "$_payload" 2>/dev/null; then
        msg "greeter palette + background updated"
    else
        msg "note: the sign-in screen keeps its previous palette/background (polkit cancelled, timed out, or unavailable)"
    fi
}

cmd_greeter() {
    sync_greeter_palette
}

cmd_reload() {
    qs -c "$CONFIG" kill >/dev/null 2>&1 || pkill -x qs 2>/dev/null || true
    # SIGTERM skips QML teardown, so the old instance's long-lived helpers
    # (pactl subscribe, playerctl --follow, nmcli monitor, cava) are orphaned.
    pkill -x pactl 2>/dev/null || true
    pkill -x playerctl 2>/dev/null || true
    pkill -f 'nmcli monitor' 2>/dev/null || true
    pkill -x cava 2>/dev/null || true
    sleep 0.3
    # This repo installs as <config>/shell/, which `-c` cannot find (it wants
    # <config>/shell.qml); prefer the path form for that layout.
    if [ -f "$HOME/.config/quickshell/$CONFIG/shell.qml" ]; then
        nohup qs -c "$CONFIG" -d >/dev/null 2>&1 &
    elif [ -d "$HOME/.config/quickshell/$CONFIG/shell" ]; then
        nohup qs -p "$HOME/.config/quickshell/$CONFIG/shell" -d >/dev/null 2>&1 &
    else
        nohup qs -d --path "$REPO_DIR/shell" >/dev/null 2>&1 &
    fi
    msg "shell restarted"
}

cmd_doctor() {
    status=0

    # Keep in sync with shell/services/Integrations.qml (the live view is
    # Settings → Integrations).
    for bin in quickshell grim slurp wf-recorder satty swappy wl-copy cliphist \
                playerctl cava matugen gsettings awww magick \
                jq brightnessctl nmcli pactl rfkill powerprofilesctl \
                xdg-open xdg-mime pkill systemctl loginctl \
                timedatectl localectl gdbus getent pkexec \
                ffmpeg ffprobe ffmpegthumbnailer; do
        if have "$bin"; then msg "ok       $bin"; else msg "MISSING  $bin"; status=1; fi
    done

    # Optional: video wallpapers render through mpvpaper.
    have mpvpaper && msg "ok       mpvpaper" \
        || msg "WARN     mpvpaper missing — video wallpapers disabled (paru -S mpvpaper)"

    # Optional: settings-app launchers and idle daemons (buttons are inert
    # without them; the shell itself keeps working).
    have nm-connection-editor && msg "ok       nm-connection-editor" \
        || msg "WARN     nm-connection-editor missing — Wi-Fi settings button is inert"
    have blueman-manager && msg "ok       blueman-manager" \
        || msg "WARN     blueman-manager missing — Bluetooth settings button is inert"
    if have hypridle || have swayidle; then
        msg "ok       idle daemon (hypridle/swayidle)"
    else
        msg "WARN     hypridle/swayidle missing — Sleep toggle is a no-op"
    fi

    # Compositor tooling (e.g. hyprctl on Hyprland) is consumer-owned — bubbles
    # only reports it when present.
    have hyprctl && msg "hyprland $(hyprctl version 2>/dev/null | head -1 | sed 's/^ *//')"
    have quickshell && msg "quickshell $(qs --version 2>/dev/null || echo '?')"
    msg "layer-shell: assumed present (wlr-layer-shell ships with quickshell)"

    if is_btrfs; then
        msg "ok       root on btrfs (snapshots available)"
    else
        msg "WARN     root is NOT btrfs — update/rollback will skip snapshots"
        [ "$status" -eq 0 ] && status=2   # warn-only exit
    fi

    # Optional: fastfetch config is written by Bubbles when the tool exists.
    have fastfetch && msg "ok       fastfetch" \
        || msg "WARN     fastfetch missing — fastfetch theming disabled"

    [ -f "$HOME/.config/matugen/config.toml" ] || msg "WARN     ~/.config/matugen/config.toml missing — app retinting limited"
    if [ -f "$HOME/.config/matugen/config.toml" ]; then
        n=$(grep -c '^\[templates\.' "$HOME/.config/matugen/config.toml" 2>/dev/null || true)
        msg "matugen  $n template(s) configured (Settings → Integrations re-applies)"
    fi

    exit "$status"
}

write_theme_pref() {
    name=$1
    mkdir -p "$STATE_DIR"
    if [ -f "$LEGACY_STATE_DIR/theme.json" ] && [ ! -f "$STATE_DIR/theme.json" ]; then
        mv "$LEGACY_STATE_DIR/theme.json" "$STATE_DIR/theme.json"
    fi
    if [ -f "$STATE_DIR/theme.json" ]; then
        tmp="$STATE_DIR/.theme.json.tmp"
        jq --arg t "$name" '.theme = $t' "$STATE_DIR/theme.json" > "$tmp" \
            || die "failed to update $STATE_DIR/theme.json"
        mv "$tmp" "$STATE_DIR/theme.json"
    else
        printf '{"theme":"%s","mode":"dark","variant":"scheme-content"}\n' "$name" > "$STATE_DIR/theme.json"
    fi
}

cmd_theme() {
    name=${1:-}
    [ -n "$name" ] || usage 1
    case " $THEMES " in
        *" $name "*) ;;
        *)
            # User themes: ~/.config/bubbles/themes/<name>.json
            [ -f "$HOME/.config/bubbles/themes/$name.json" ] \
                || die "unknown theme '$name' (see: bubbles --help)"
            ;;
    esac

    write_theme_pref "$name"

    # Live apply via IPC; falls back to next shell start when not running.
    if shell_ipc call bubbles setTheme "$name" 2>/dev/null; then
        msg "theme set to '$name'"
    else
        msg "shell not running — theme applies on next start"
    fi

    sleep 1                       # let the shell resolve + snapshot the palette
    sync_greeter_palette
}

cmd_update() {
    do_packages=0
    [ "${1:-}" = "-S" ] && do_packages=1

    have git || die "git not found"
    have qs || die "quickshell not found"

    # Package step FIRST: fail here and nothing has been touched (PRD §7).
    if [ "$do_packages" -eq 1 ]; then
        have paru || die "paru not found (-S needs it)"
        paru -Syu || die "package step failed — aborted before any change"
    fi

    snapshot pre
    git -C "$REPO_DIR" pull --ff-only || { msg "config pull failed (pre-snapshot kept)"; exit 1; }
    cmd_reload
    snapshot post
    sync_greeter_palette
    msg "update complete"
}

cmd_rollback() {
    is_btrfs || die "root is not btrfs — nothing to roll back to"
    [ -d "$SNAP_DIR" ] || die "no $SNAP_DIR snapshots found"

    latest=$(ls -1d "$SNAP_DIR"/pre-* 2>/dev/null | sort | tail -1)
    [ -n "${latest:-}" ] || die "no pre-update snapshots found"

    printf 'about to restore %s over / — this replaces the live root.\n' "$latest"
    printf 'type 'yes' to continue: '
    read -r answer
    [ "$answer" = "yes" ] || die "aborted"

    rsync -aHAAX --delete "$latest/" /
    msg "rollback done — reboot recommended"
}

case "${1:-}" in
    reload)   shift; cmd_reload "$@" ;;
    doctor)   shift; cmd_doctor "$@" ;;
    theme)    shift; cmd_theme "$@" ;;
    update)   shift; cmd_update "$@" ;;
    greeter)  shift; cmd_greeter "$@" ;;
    rollback) shift; cmd_rollback "$@" ;;
    -h|--help|help|"") usage ;;
    *)        usage 1 ;;
esac
