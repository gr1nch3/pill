// Bubbles SDDM greeter (PRD §5.2/§6.6).
// The same face as the session lock: procedural eyes above a pill that expands
// into the password input. Eye.qml is copied into this directory at package
// time (see PKGBUILD) so the greeter and the lock share one identity instead
// of two implementations drifting apart.
//
// Chrome is deliberately text-only: session picker, reboot and shutdown in the
// top right; the account picker in the bottom right. No backgrounds, no
// settings — the face and the pill are the whole UI.
//
// `sddm`, `userModel` and `sessionModel` are greeter context properties (same
// as the stock themes); SDDM 0.21 ships no QML module to import.

// Versioned: SDDM's X11 greeter is the Qt 5.15 build of sddm-greeter, where
// `import QtQuick` without a version is a fatal "Library import requires a
// version" (Qt 6 accepts the 2.15 version too).
import QtQuick 2.15

Rectangle {
    id: root

    // ── Palette: generated by the shell to /etc/xdg/bubbles/GreeterPalette.qml
    // and loaded here. Qt blocks XHR reads of local files in the greeter, and
    // QML component loading is the one file read it allows. A missing file
    // falls back to the embedded palette: a cosmetic theme failure must never
    // block login (ryoku lesson).
    readonly property var fallbackPal: ({
            background: "#0b0b10",
            surface: "#15151a",
            accent: "#4ecdc4",
            text: "#f0f0f5",
            subtext: "#8a8a99",
            danger: "#ff6b6b",
            border: "#28a8a899",
            eyesEnabled: true,
            eyeVariant: "normal",
            clockFormat: "12",
            fontFamily: "",
            fontScale: 1,
            lockWallpaper: true,
            lockPattern: true,
            patternStyle: "dots",
            patternDensity: "normal"
        })

    Loader {
        id: paletteLoader
        source: "file:///etc/xdg/bubbles/GreeterPalette.qml"
    }

    // variable key: the loader's item is dynamic QML, its palette member is
    // not statically declarable
    readonly property var pal: {
        var it = paletteLoader.item;
        var key = "palette";
        return it && it[key] ? it[key] : root.fallbackPal;
    }

    color: pal.background

    // ── Background: installed by the shell + scrim + pattern overlay. The
    // greeter can't read the user's home, so the files come from
    // /etc/xdg/bubbles (see bin/bubbles). A push installs exactly one of the
    // two: the animated gif for gif backgrounds, the bounded still otherwise.
    // Status picks it — no palette/kind bookkeeping. ──────────────────────
    Image {
        anchors.fill: parent
        source: root.pal.lockWallpaper !== false ? "file:///etc/xdg/bubbles/greeter-wallpaper.jpg" : ""
        fillMode: Image.PreserveAspectCrop
        asynchronous: true
        visible: status === Image.Ready
    }

    AnimatedImage {
        anchors.fill: parent
        source: root.pal.lockWallpaper !== false ? "file:///etc/xdg/bubbles/greeter-wallpaper.gif" : ""
        fillMode: Image.PreserveAspectCrop
        asynchronous: true
        visible: status === AnimatedImage.Ready
    }

    Rectangle {
        anchors.fill: parent
        color: "#A0000000"
    }

    PatternBackground {
        anchors.fill: parent
        visible: root.pal.lockPattern !== false && (root.pal.patternStyle || "none") !== "none"
        variant: root.pal.patternStyle || "none"
        spacing: root.pal.patternDensity === "dense" ? 13 : (root.pal.patternDensity === "sparse" ? 26 : 18)
        strength: 0.06
        color: root.pal.accent
        shape: "rect"
    }

    readonly property real fontScale: root.pal.fontScale > 0 ? root.pal.fontScale : 1
    // Empty family = Qt default; a custom shell font carries over when set.
    readonly property string fontFamily: root.pal.fontFamily && root.pal.fontFamily !== "" ? root.pal.fontFamily : ""
    function fs(size) {
        return Math.round(size * root.fontScale);
    }

    property string currentUser: userModel.lastUser
    property int sessionIndex: sessionModel.lastIndex >= 0 ? sessionModel.lastIndex : 0
    property string authState: "idle"
    property bool sessionListOpen: false
    property bool userListOpen: false
    property bool _authInFlight: false

    // Rows collected by invisible delegates so the text-only pickers can
    // render outside a Repeater (the arrays mutate in place, no notify).
    property var sessionNames: []
    property var userNames: []
    property var userRealNames: []

    Repeater {
        model: sessionModel
        Item {
            required property string name
            required property int index
            // Reassign (not push): the list Repeater + label bindings need the
            // change notification, and a JS array mutating in place sends none.
            Component.onCompleted: {
                var names = root.sessionNames.slice();
                names[index] = name;
                root.sessionNames = names;
            }
        }
    }

    Repeater {
        model: userModel
        Item {
            required property string name
            required property string realName
            required property int index
            Component.onCompleted: {
                var names = root.userNames.slice();
                names[index] = name;
                root.userNames = names;
                var reals = root.userRealNames.slice();
                reals[index] = realName;
                root.userRealNames = reals;
                if (root.currentUser === "" && name)
                    root.currentUser = name;
            }
        }
    }

    function userIndex(name) {
        for (var i = 0; i < root.userNames.length; i++)
            if (root.userNames[i] === name)
                return i;
        return -1;
    }

    readonly property string userLabel: {
        var i = root.userIndex(root.currentUser);
        var real = i >= 0 ? root.userRealNames[i] : "";
        return real !== "" ? real : (root.currentUser || "User");
    }
    readonly property string sessionLabel: root.sessionNames[root.sessionIndex] || "Session"

    // Clicking anywhere that isn't a text action closes the pickers and opens
    // the pill. Declared before the face/pickers so it stays the bottom-most
    // click target — later siblings (TextAction, TextInput, arrow) win.
    MouseArea {
        anchors.fill: parent
        onClicked: {
            root.sessionListOpen = false;
            root.userListOpen = false;
            if (!pill.expanded)
                root.expand();
            else
                passwordField.forceActiveFocus();
        }
    }

    // ── Face: eyes above, pill below (same geometry as the session lock) ──
    readonly property bool faceOn: root.pal.eyesEnabled !== false
    readonly property real faceCenterY: height / 2
    readonly property real eyesCenterY: root.faceCenterY - (root.faceOn ? 92 : 0)
    readonly property real pillCenterY: root.faceCenterY + (root.faceOn ? 52 : 0)

    Eye {
        id: eyes
        anchors.horizontalCenter: parent.horizontalCenter
        y: root.eyesCenterY - height / 2
        eyeWidth: 96
        eyeHeight: 68
        eyeSpacing: 44
        variant: root.pal.eyeVariant || "normal"
        visible: root.faceOn
        mood: root.authState === "error" ? "error" : (pill.expanded ? "active" : "idle")
        moods: ({
                idle: {
                    color: root.pal.subtext,
                    opacity: 0.55
                },
                active: {
                    color: root.pal.accent,
                    opacity: 1.0
                },
                alert: {
                    color: "#f0a500",
                    opacity: 1.0
                },
                error: {
                    color: root.pal.danger,
                    opacity: 1.0
                }
            })
    }

    // ── Pill: compact clock, expands into the password input ──────────────
    Rectangle {
        id: pill

        property bool expanded: false
        // expanded = margins (24*2) + input; 360 was field+arrow+spacing
        property real _targetW: expanded ? 306 : 240
        property real _targetH: expanded ? 92 : 72
        property real _targetY: root.pillCenterY - _targetH / 2

        width: _targetW
        height: _targetH
        x: (parent.width - width) / 2
        y: _targetY
        radius: expanded ? 24 : _targetH / 2
        color: root.pal.surface
        border.width: 1
        border.color: root.pal.border

        Behavior on _targetW {
            NumberAnimation {
                duration: 500
                easing.type: Easing.OutBack
                easing.overshoot: 1.0
            }
        }
        Behavior on _targetH {
            NumberAnimation {
                duration: 500
                easing.type: Easing.OutBack
                easing.overshoot: 1.0
            }
        }
        Behavior on _targetY {
            NumberAnimation {
                duration: 500
                easing.type: Easing.OutBack
                easing.overshoot: 1.0
            }
        }
        Behavior on radius {
            NumberAnimation {
                duration: 500
                easing.type: Easing.OutBack
                easing.overshoot: 1.0
            }
        }

        // ── Compact: time + lock mark ─────────────────────────────────────
        Item {
            id: compact
            anchors.fill: parent
            anchors.margins: 3
            opacity: !pill.expanded ? 1 : 0
            visible: opacity > 0
            Behavior on opacity {
                NumberAnimation {
                    duration: 120
                }
            }

            property date now: new Date()
            readonly property bool format24h: root.pal.clockFormat !== "12"
            readonly property string hours: {
                var h = compact.now.getHours();
                if (compact.format24h)
                    return (h < 10 ? "0" : "") + h;
                return String((h % 12) || 12);
            }
            readonly property string minutes: Qt.formatTime(compact.now, "mm")
            readonly property string ampm: Qt.formatTime(compact.now, "AP")

            Timer {
                interval: 1000
                running: compact.visible
                repeat: true
                onTriggered: compact.now = new Date()
            }

            Row {
                anchors.centerIn: parent
                spacing: 10

                Row {
                    anchors.verticalCenter: parent.verticalCenter
                    spacing: 1

                    Text {
                        anchors.verticalCenter: parent.verticalCenter
                        text: compact.hours
                        color: root.pal.text
                        font.family: root.fontFamily
                        font.pixelSize: root.fs(20)
                        font.weight: Font.Bold
                    }

                    Text {
                        anchors.verticalCenter: parent.verticalCenter
                        text: ":"
                        color: root.pal.text
                        font.family: root.fontFamily
                        font.pixelSize: root.fs(20)
                        font.weight: Font.Bold
                        SequentialAnimation on opacity {
                            running: compact.visible
                            loops: Animation.Infinite
                            NumberAnimation {
                                to: 0.25
                                duration: 700
                            }
                            NumberAnimation {
                                to: 1.0
                                duration: 700
                            }
                        }
                    }

                    Text {
                        id: minutesText
                        anchors.verticalCenter: parent.verticalCenter
                        text: compact.minutes
                        color: root.pal.text
                        font.family: root.fontFamily
                        font.pixelSize: root.fs(20)
                        font.weight: Font.Bold
                    }

                    Text {
                        visible: !compact.format24h
                        anchors.verticalCenter: parent.verticalCenter
                        anchors.bottom: minutesText.bottom
                        anchors.bottomMargin: 2
                        text: compact.ampm
                        color: root.pal.subtext
                        font.family: root.fontFamily
                        font.pixelSize: root.fs(11)
                    }
                }

                // Lock mark: flat line art, no icon-font dependency.
                Item {
                    anchors.verticalCenter: parent.verticalCenter
                    width: root.fs(16)
                    height: root.fs(19)

                    Rectangle {
                        anchors.horizontalCenter: parent.horizontalCenter
                        width: root.fs(10)
                        height: root.fs(11)
                        radius: width / 2
                        color: "transparent"
                        border.width: 2
                        border.color: root.pal.accent
                    }

                    Rectangle {
                        anchors.horizontalCenter: parent.horizontalCenter
                        anchors.bottom: parent.bottom
                        width: parent.width
                        height: root.fs(11)
                        radius: root.fs(3)
                        color: root.pal.accent
                    }
                }
            }
        }

        // ── Expanded: password input (Enter submits) ──────────────────────
        Item {
            anchors.fill: parent
            anchors.margins: pill.expanded ? 24 : 0
            opacity: pill.expanded ? 1 : 0
            visible: opacity > 0
            Behavior on opacity {
                NumberAnimation {
                    duration: 200
                    easing.type: Easing.OutCubic
                }
            }
            Behavior on anchors.margins {
                NumberAnimation {
                    duration: 200
                }
            }

            Row {
                anchors.centerIn: parent
                width: parent.width
                height: 44
                spacing: 10

                Rectangle {
                    width: parent.width
                    height: parent.height
                    radius: 10
                    color: root.pal.background
                    border.width: 1
                    border.color: passwordField.activeFocus ? root.pal.accent : root.pal.border
                    Behavior on border.color {
                        ColorAnimation {
                            duration: 150
                        }
                    }

                    TextInput {
                        id: passwordField
                        anchors.fill: parent
                        anchors.margins: 12
                        color: root.pal.text
                        font.family: root.fontFamily
                        font.pixelSize: root.fs(13)
                        echoMode: TextInput.Password
                        passwordCharacter: "●"
                        onAccepted: root.submit()
                        Keys.onEscapePressed: root.collapse()
                    }
                }
            }
        }
    }

    // ── Error + hint, below the face ──────────────────────────────────────
    Text {
        id: errorText
        anchors.horizontalCenter: parent.horizontalCenter
        y: pill.y + pill.height + 12
        text: ""
        visible: text !== ""
        color: root.pal.danger
        font.family: root.fontFamily
        font.pixelSize: root.fs(11)
        wrapMode: Text.WordWrap
        horizontalAlignment: Text.AlignHCenter
    }

    Text {
        anchors.horizontalCenter: parent.horizontalCenter
        y: pill.y + pill.height + 24
        text: "Press any key to sign in"
        color: root.pal.subtext
        font.family: root.fontFamily
        font.pixelSize: root.fs(11)
        opacity: !pill.expanded ? 1 : 0
        visible: opacity > 0
        Behavior on opacity {
            NumberAnimation {
                duration: 200
            }
        }
        SequentialAnimation on opacity {
            running: !pill.expanded
            loops: Animation.Infinite
            NumberAnimation {
                to: 0.4
                duration: 2000
            }
            NumberAnimation {
                to: 1.0
                duration: 2000
            }
        }
    }

    // ── Top right: session picker, reboot, shutdown — text only ───────────
    Row {
        id: topActions
        anchors.top: parent.top
        anchors.right: parent.right
        anchors.topMargin: 28
        anchors.rightMargin: 28
        spacing: 26

        TextAction {
            text: root.sessionLabel
            pal: root.pal
            fontFamily: root.fontFamily
            fontSize: root.fs(13)
            selected: root.sessionListOpen
            onActivated: root.sessionListOpen = !root.sessionListOpen
        }

        TextAction {
            text: "Reboot"
            pal: root.pal
            fontFamily: root.fontFamily
            fontSize: root.fs(13)
            onActivated: sddm.reboot()
        }

        TextAction {
            text: "Shutdown"
            pal: root.pal
            fontFamily: root.fontFamily
            fontSize: root.fs(13)
            onActivated: sddm.powerOff()
        }
    }

    Column {
        id: sessionList
        anchors.top: topActions.bottom
        anchors.topMargin: 10
        anchors.right: parent.right
        anchors.rightMargin: 28
        spacing: 12
        opacity: root.sessionListOpen ? 1 : 0
        visible: opacity > 0
        Behavior on opacity {
            NumberAnimation {
                duration: 160
                easing.type: Easing.OutCubic
            }
        }

        Repeater {
            model: root.sessionNames

            TextAction {
                required property string modelData
                required property int index
                text: modelData
                pal: root.pal
                fontFamily: root.fontFamily
                fontSize: root.fs(13)
                selected: index === root.sessionIndex
                onActivated: {
                    root.sessionIndex = index;
                    root.sessionListOpen = false;
                    root.forceActiveFocus();
                }
            }
        }
    }

    // ── Bottom right: account picker — text only ──────────────────────────
    Column {
        id: userList
        anchors.bottom: userButton.top
        anchors.bottomMargin: 10
        anchors.right: parent.right
        anchors.rightMargin: 28
        spacing: 12
        opacity: root.userListOpen ? 1 : 0
        visible: opacity > 0
        Behavior on opacity {
            NumberAnimation {
                duration: 160
                easing.type: Easing.OutCubic
            }
        }

        Repeater {
            model: root.userNames

            TextAction {
                required property string modelData
                required property int index
                text: modelData
                pal: root.pal
                fontFamily: root.fontFamily
                fontSize: root.fs(13)
                selected: modelData === root.currentUser
                onActivated: {
                    root.currentUser = modelData;
                    root.userListOpen = false;
                    if (pill.expanded)
                        Qt.callLater(function () {
                            passwordField.forceActiveFocus();
                        });
                    else
                        root.forceActiveFocus();
                }
            }
        }
    }

    TextAction {
        id: userButton
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        anchors.bottomMargin: 28
        anchors.rightMargin: 28
        text: root.userLabel
        pal: root.pal
        fontFamily: root.fontFamily
        fontSize: root.fs(13)
        selected: root.userListOpen
        onActivated: root.userListOpen = !root.userListOpen
    }

    // ── Keyboard ──────────────────────────────────────────────────────────
    focus: true
    Keys.onPressed: event => {
        if (!pill.expanded) {
            root.expand();
            event.accepted = true;
        }
    }
    Keys.onEscapePressed: root.collapse()

    function expand() {
        pill.expanded = true;
        Qt.callLater(function () {
            passwordField.forceActiveFocus();
        });
    }

    function collapse() {
        if (root.sessionListOpen || root.userListOpen) {
            root.sessionListOpen = false;
            root.userListOpen = false;
            return;
        }
        if (pill.expanded) {
            pill.expanded = false;
            passwordField.text = "";
            errorText.text = "";
        }
        root.forceActiveFocus();
    }

    function submit() {
        if (passwordField.text === "" || root._authInFlight)
            return;
        errorText.text = "";
        root._authInFlight = true;
        sddm.login(root.currentUser, passwordField.text, root.sessionIndex);
    }

    Connections {
        target: sddm
        function onLoginFailed() {
            root._authInFlight = false;
            root.authState = "error";
            errorText.text = "Authentication failed";
            passwordField.text = "";
            pill.expanded = true;
            Qt.callLater(function () {
                passwordField.forceActiveFocus();
            });
            failTimer.restart();
        }
    }

    Timer {
        id: failTimer
        interval: 2000
        onTriggered: root.authState = "idle"
    }
}
